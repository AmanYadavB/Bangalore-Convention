{
  "name": "bangalore-convention",
  "version": "1.0.0",
  "description": "Bangalore Convention registration and funds management site (Cloudflare Worker + static frontend)",
  "main": "worker.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dev-server.js",
    "dev": "node dev-server.js",
    "dev:worker": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "test:syntax": "node --test tests/build-gates/syntax.test.mjs",
    "test:assets": "node --test tests/build-gates/assets.test.mjs",
    "test:secrets": "node --test tests/build-gates/secrets.test.mjs",
    "test:build:prod": "npx wrangler deploy --dry-run",
    "test:build:staging": "npx wrangler deploy --config wrangler.staging.toml --dry-run",
    "test:smoke:pages": "node --test tests/smoke/pages.test.mjs",
    "test:smoke:api": "node --test tests/smoke/api-health.test.mjs",
    "test:smoke:rbac": "node --test tests/smoke/rbac.test.mjs",
    "test:smoke:headers": "node --test tests/smoke/headers.test.mjs",
    "test:smoke": "node --test tests/smoke/pages.test.mjs tests/smoke/api-health.test.mjs tests/smoke/rbac.test.mjs tests/smoke/headers.test.mjs",
    "test:build-gates": "npm run test:syntax && npm run test:assets && npm run test:secrets && npm run test:build:prod && npm run test:build:staging",
    "test": "npm run test:build-gates"
  }
}
